# Apache / LiteSpeed — Dr. Carlos Gómez
#
# DIAGNÓSTICO (nov 2026): en producción este archivo existe pero el servidor NO devuelve las cabeceras de las
# secciones 2 y 3 (ni siquiera en la raíz de WordPress). Falta activar en el hosting mod_headers y mod_expires
# y permitir sobrescribir la configuración (AllowOverride FileInfo). Comprobar con:
#   curl -I https://www.drcarlosgomez.doc.ec/el-cirujano-que-cambia-vidas/css/base.css
# Debe mostrar Cache-Control/Expires; y en la página: Content-Security-Policy y Strict-Transport-Security.

# 1. Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 2. Caché del navegador
#    CSS y JS no llevan hash en el nombre: caché corta para que los cambios lleguen a quien ya visitó el sitio.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 3. Cabeceras de seguridad
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(self \"https://www.youtube-nocookie.com\")"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  # CSP: solo se permite lo que usa el sitio. El contenedor GTM-TVL2KNGP (revisado en nov 2026) usa Google Tag (GA4),
  # Google Ads, Conversion Linker y la plantilla de Meta Pixel; no tiene etiquetas "HTML personalizado" ni JavaScript
  # personalizado, por eso no hace falta 'unsafe-inline'. Si se añade una etiqueta nueva y no carga, agregar su dominio aquí.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://*.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://analytics.tiktok.com https://googleads.g.doubleclick.net https://www.googleadservices.com https://pagead2.googlesyndication.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.googletagmanager.com https://*.google-analytics.com https://*.doubleclick.net https://*.googlesyndication.com https://www.google.com https://www.google.com.ec https://www.facebook.com https://analytics.tiktok.com; connect-src 'self' https://n8n.agenciasm.marketing https://*.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.doubleclick.net https://*.googlesyndication.com https://adservice.google.com https://www.google.com https://www.google.com.ec https://www.googleadservices.com https://www.facebook.com https://analytics.tiktok.com; frame-src https://www.youtube-nocookie.com https://www.googletagmanager.com https://*.doubleclick.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# 4. Sin listado de directorios
Options -Indexes
